PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/chatapp
JWT_SECRET=replace-with-a-random-secret
# Optional in local development; required to expose /metrics in production.
METRICS_TOKEN=
SERVICE_NAME=chatapp-backend
# Comma-separated browser origins. In production, set this to your frontend domain(s).
CORS_ORIGIN=http://localhost:5173
# Set COOKIE_SECURE=false only for non-TLS staging environments.
COOKIE_SECURE=
# Configure one Redis endpoint option for multi-replica production deployments.
REDIS_URL=
# Comma-separated redis:// or rediss:// node URLs for Redis Cluster deployments.
REDIS_CLUSTER_NODES=
